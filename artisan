#!/usr/bin/env php
<?php

define('LARAVEL_START', microtime(true));

$args = $argv;
array_shift($args);

$command = $args[0] ?? 'list';

if ($command === 'serve') {
    $host = '0.0.0.0';
    $port = '8000';
    foreach ($args as $arg) {
        if (str_starts_with($arg, '--host=')) {
            $host = substr($arg, 7);
        }
        if (str_starts_with($arg, '--port=')) {
            $port = substr($arg, 7);
        }
    }
    echo "\033[32m[Laravel Docker App]\033[0m Server running at: http://{$host}:{$port}\n";
    passthru("php -S {$host}:{$port} server.php");
    exit(0);
}

if ($command === 'migrate') {
    echo "\033[36m[Migrate]\033[0m Menyiapkan tabel PostgreSQL...\n";
    require_once __DIR__ . '/database/migrate.php';
    exit(0);
}

if ($command === '--version' || $command === '-V') {
    echo "Laravel Framework (Docker Web Environment) 10.x\n";
    exit(0);
}

echo "Laravel Artisan CLI\n";
echo "Perintah yang tersedia:\n";
echo "  php artisan serve       Menjalankan server aplikasi\n";
echo "  php artisan migrate     Menjalankan migrasi database PostgreSQL\n";
echo "  php artisan --version   Melihat versi aplikasi\n";
